# =============================================================================
# Project #3 - WhatsApp Business Bot + Evolution API
# LOCAL DEVELOPMENT EXAMPLE CONFIGURATION
# =============================================================================
#
# Copy this file to `.env` to override the defaults:
#
#     Copy-Item .env.example .env      # Windows PowerShell
#     cp .env.example .env             # macOS / Linux
#
# Every value below is a DEVELOPMENT PLACEHOLDER. These are not secrets, they
# grant access to nothing but throwaway containers on this machine, and this
# file is safe to commit precisely because it contains no working credential.
#
# `.env` itself is git-ignored - never commit it, and never put a real
# production key or a real WhatsApp number in it.
#
# Docker Compose reads this file automatically for ${VARIABLE} interpolation.
# The FastAPI application reads it through pydantic-settings.
# =============================================================================


# -----------------------------------------------------------------------------
# SECTION 1 - Docker Compose stack settings
# -----------------------------------------------------------------------------

# Host port Evolution API is published on. Bound to 127.0.0.1 only.
EVOLUTION_PORT=8080

# PostgreSQL credentials, used both by the `postgres` container and by
# Evolution API to build its DATABASE_CONNECTION_URI. Change all three
# together - they are deliberately wired to the same variables.
POSTGRES_DATABASE=evolution
POSTGRES_USERNAME=evolution
POSTGRES_PASSWORD=evolution


# -----------------------------------------------------------------------------
# SECTION 2 - Evolution API authentication
# -----------------------------------------------------------------------------

# Global API key for Evolution API. This is the value the bot sends in the
# `apikey` HTTP header. The placeholder is a published development default -
# NOT a credential. Replace it if you ever expose the service beyond loopback.
EVOLUTION_API_KEY=dev-local-api-key


# -----------------------------------------------------------------------------
# SECTION 3 - FastAPI bot application
# -----------------------------------------------------------------------------

# Base URL of the Evolution API. Matches the Compose port above.
EVOLUTION_API_URL=http://127.0.0.1:8080

# WhatsApp instance name inside Evolution API.
# Placeholder on purpose: this project does NOT connect a real WhatsApp number,
# so no instance is created and no QR code is ever scanned.
EVOLUTION_INSTANCE=demo

# Public URL of this bot's own /webhook endpoint, to be registered in
# Evolution API once an instance exists. Not used yet.
#
# From the Evolution API CONTAINER, the host FastAPI app is reached through
# host.docker.internal - NOT 127.0.0.1, which inside a container refers to the
# container itself:
#     http://host.docker.internal:8000/webhook
WEBHOOK_URL=

# Outbound HTTP timeout in seconds.
REQUEST_TIMEOUT=15

# Python log level.
LOG_LEVEL=INFO


# -----------------------------------------------------------------------------
# SECTION 4 - Incoming webhook authentication (OPTIONAL)
# -----------------------------------------------------------------------------

# Shared secret expected in the `x-webhook-token` header on every incoming
# /webhook call. LEAVE EMPTY for local testing: an empty value disables the
# check entirely, which is why the local smoke tests need no configuration.
#
# Evolution API v2 does NOT sign webhooks with HMAC. The mechanism it actually
# supports is a per-instance `headers` object, configured via
#     POST /webhook/set/{instance}
# so you would set, for example:
#     "headers": { "x-webhook-token": "<same value you put here>" }
#
# Note: the *global* webhook (WEBHOOK_GLOBAL_URL) cannot carry custom headers,
# so authentication requires a per-instance webhook registration.
#
# When set, an incorrect or missing header returns HTTP 401. The value is a
# SecretStr: it is masked in /config and never written to logs.
WEBHOOK_SECRET=

# Optional comma-separated allowlist of Evolution instance names accepted by
# /webhook. Empty means no filtering. Useful when several instances share one
# bot deployment.
WEBHOOK_ALLOWED_INSTANCES=

