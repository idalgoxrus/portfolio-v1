# Шаблон окружения. Скопируйте в .env и заполните.
# В файле только имена переменных и примеры-заглушки — реальных токенов и ключей здесь нет.
# Полный список параметров и значения по умолчанию — app/core/config.py.

# --- Telegram (обязательно) ---
# Токен от @BotFather. Формат <id>:<строка> проверяется на старте: опечатка
# приводит к понятной ошибке конфигурации, а не к падению после запуска.
BOT_TOKEN=

# --- n8n (необязательно) ---
# URL production webhook воркфлоу n8n/workflows/lead_intake.json.
# Пока n8n не запущен, оставьте строку закомментированной: иначе бот будет
# ждать недоступный webhook и помечать лиды статусом failed.
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/telegram-lead

# Секрет для заголовка X-Webhook-Token; должен совпадать с проверкой на стороне n8n.
# N8N_WEBHOOK_SECRET=

# --- Общие параметры (необязательно) ---
# Уровень логирования: DEBUG / INFO / WARNING / ERROR / CRITICAL
LOG_LEVEL=INFO

# Чат администратора для прямых уведомлений (тот же id, что TELEGRAM_ADMIN_CHAT_ID в n8n)
# ADMIN_CHAT_ID=

# Токен для read-only админ-эндпоинтов FastAPI (/leads, /stats/daily, /follow-ups).
# Пусто = доступ без токена (локальная разработка). В публичном деплое задайте
# значение и передавайте его в заголовке X-Admin-Token (так делает n8n).
# ADMIN_API_TOKEN=

# Таймаут одного webhook-запроса в секундах: 0 < x <= 120
# HTTP_TIMEOUT=10

# Число повторов передачи лида при сбое: 0..10
# HTTP_RETRIES=2

# Путь к файлу SQLite; относительный путь считается от корня проекта
# DATABASE_PATH=data/leads.sqlite3
